{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-default",
      "displayName": "macOS Homebrew Clang",
      "binaryDir": "${sourceDir}/build",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_PREFIX_PATH": "/opt/homebrew",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "macos-default"
    }
  ]
}